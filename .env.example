# Set these in the process environment or a secrets manager. Do not commit real values.
# Prefer a protected CDP JSON file, or set the two values below instead.
COINBASE_KEY_FILE=/absolute/path/to/cdp_api_key.json
COINBASE_API_KEY=organizations/your-org-id/apiKeys/your-key-id
COINBASE_API_SECRET=your-private-key

TICKER=AAPL
TRADE_USD_AMOUNT=100
STOP_LOSS_PERCENT=0.10
TRADE_STATE_PATH=trade_state.json
BOT_SETTINGS_PATH=bot_settings.json
DRY_RUN=true

# Required only when hosting the authenticated dashboard.
# This bootstraps login until a password is changed in the dashboard.
DASHBOARD_PASSWORD=choose-a-strong-local-password
DASHBOARD_PASSWORD_PATH=dashboard_password.json
DASHBOARD_SESSION_SECRET=generate-a-long-random-value
